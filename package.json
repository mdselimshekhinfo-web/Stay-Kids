{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "vitest run",
    "build:parent": "vite build --mode parent && move dist\\index-parent.html dist\\index.html",
    "build:child": "vite build --mode child && move dist\\index-child.html dist\\index.html",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:parent": "npm run build:parent && npm run android:sync && cd android && gradlew assembleParentDebug",
    "android:child": "npm run build:child && npm run android:sync && cd android && gradlew assembleChildDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@supabase/supabase-js": "^2.112.0",
    "@types/leaflet": "^1.9.21",
    "capacitor-secure-storage-plugin": "^0.10.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
