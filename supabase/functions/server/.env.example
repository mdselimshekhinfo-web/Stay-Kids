# Local development secrets for Supabase Edge Functions
# DO NOT COMMIT THIS FILE OR REAL SECRETS TO VERSION CONTROL

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret-here

# This value is bundled into the client APK and is not truly secret — it only protects against casual tampering, not a determined attacker with the APK. Rotate periodically.
HMAC_SECRET=<GENERATE_NEW_RANDOM_SECRET>

BREVO_API_KEY=your-brevo-api-key-here
